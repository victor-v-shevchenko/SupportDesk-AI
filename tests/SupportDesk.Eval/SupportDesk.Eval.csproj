<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Reads AI:Anthropic:ApiKey from the API's user secrets, so one "dotnet user-secrets set" serves both -->
    <UserSecretsId>supportdesk-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- The VSTest variant of xunit.v3, so dotnet test takes the trait filter -->
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SupportDesk.Api\SupportDesk.Api.csproj" />
    <!-- The golden set and fixture file types, so the suite reads exactly what the tool writes -->
    <ProjectReference Include="..\..\tools\EmbedFixtures\EmbedFixtures.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The golden set, its query embeddings, the article fixtures they're checked against, and the thresholds -->
  <ItemGroup>
    <Content Include="golden\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\fixtures\embeddings\articles.json" Link="fixtures\embeddings\articles.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="eval-thresholds.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Shows each estimate next to Anthropic's count, passing or not -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
