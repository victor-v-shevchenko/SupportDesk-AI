{
  "name": "SupportDesk AI",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.devcontainer.yml"],
  "service": "dev",
  // Start only the dev container and the database; api and web run from the dev container while developing
  "runServices": ["dev", "db"],
  "workspaceFolder": "/workspaces/SupportDesk-AI",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" },
    "ghcr.io/devcontainers/features/node:1": { "version": "26" },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [5080, 4200],
  "portsAttributes": {
    "5080": { "label": "API" },
    "4200": { "label": "Angular" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "angular.ng-template",
        "dbaeumer.vscode-eslint",
        "SonarSource.sonarlint-vscode",
        "anthropic.claude-code"
      ]
    }
  }
}
