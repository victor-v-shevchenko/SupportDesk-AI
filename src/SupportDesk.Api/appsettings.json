{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "O",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "HealthCheckTimeoutSeconds": 3
  },
  "Seed": {
    "Path": "seed"
  },
  "Retrieval": {
    "MinSimilarity": 0.5,
    "EmbeddingBatchSize": 16
  },
  "AI": {
    "Chat": {
      "Provider": "Ollama",
      "Model": ""
    },
    "Embeddings": {
      "Provider": "Ollama",
      "Model": "",
      "Dimensions": 1024
    },
    "Ollama": {
      "Endpoint": "http://host.docker.internal:11434"
    },
    "Timeouts": {
      "ConnectSeconds": 10,
      "NonStreamingSeconds": 30,
      "FirstItemSeconds": 20,
      "GapSeconds": 15,
      "StreamTotalSeconds": 120
    },
    "PromptsPath": "prompts",
    "Prompts": {
      "reply": "reply.v1",
      "summary": "summary.v1",
      "classify": "classify.v2"
    },
    "Anthropic": {
      "Effort": {
        "Reply": "Medium",
        "Summary": "Low",
        "Classification": "Low"
      }
    },
    "Fake": {
      "ScenariosPath": "fixtures/fake-scenarios.json"
    },
    "Retry": {
      "MaxAttempts": 3,
      "BaseDelayMs": 500,
      "MaxDelayMs": 10000
    },
    "Budget": {
      "MaxInputTokensPerCall": 6000,
      "MaxOutputTokens": {
        "Reply": 800,
        "Summary": 200,
        "Classification": 200
      },
      "MaxTokensPerRequest": 20000
    },
    "Pricing": [
      {
        "Model": "claude-opus-5-5",
        "InputPerMTok": 4.00,
        "OutputPerMTok": 20.00
      },
      {
        "Model": "claude-sonnet-5-5",
        "InputPerMTok": 2.00,
        "OutputPerMTok": 10.00
      },
      {
        "Model": "claude-haiku-5-5",
        "InputPerMTok": 0.10,
        "OutputPerMTok": 0.5
      },
      {
        "Model": "qwen2.5:1.5b",
        "InputPerMTok": 0,
        "OutputPerMTok": 0
      },
      {
        "Model": "qwen2.5:7b",
        "InputPerMTok": 0,
        "OutputPerMTok": 0
      },
      {
        "Model": "fake",
        "InputPerMTok": 0,
        "OutputPerMTok": 0
      }
    ],
    "Usage": {
      "QueueCapacity": 1000
    }
  }
}
