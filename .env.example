# Copy this file to .env (gitignored) and fill it in. Never commit .env.
# docker compose (at the repository root) reads .env. The dev container uses only the POSTGRES_* values from it.

# Database. The user and database names are not secret; the password is.
POSTGRES_USER=supportdesk
POSTGRES_PASSWORD=
POSTGRES_DB=supportdesk
# ConnectionStrings__SupportDesk is built from these three values in docker-compose.yml,
# so the password lives in one place.

# Model providers for docker compose: Fake, Ollama, Anthropic or OpenAI (chat); Fake, Ollama, Voyage or OpenAI (embeddings).
# Not secret. In the dev container, pass AI__Chat__Provider on the command line instead (see CLAUDE.md).
AI_CHAT_PROVIDER=Ollama
AI_EMBEDDINGS_PROVIDER=Ollama
# Models for docker compose; empty means the provider's default (qwen2.5:1.5b, claude-opus-5-5, mxbai-embed-large, ...).
# OpenAI chat has no default and needs AI_CHAT_MODEL.
AI_CHAT_MODEL=
AI_EMBEDDINGS_MODEL=
# Minimum cosine similarity for retrieved chunks (default 0.5). With AI_EMBEDDINGS_PROVIDER=Fake set it to 0:
# the fake embeddings are hashes, so 0.5 drops every chunk and replies cite nothing.
RETRIEVAL_MIN_SIMILARITY=
# Where the API container finds Ollama: on the host (the default), or http://ollama:11434 for the optional ollama
# service (docker compose --profile ollama up -d ollama)
OLLAMA_ENDPOINT=http://host.docker.internal:11434

# Where the API container sends traces, metrics and logs (OTLP over gRPC). Empty means no export. For the optional dashboard
# (docker compose --profile telemetry up -d telemetry), set http://telemetry:18889 and open http://localhost:18888
OTEL_EXPORTER_OTLP_ENDPOINT=

# Model provider keys. Fill in only the ones you use; Ollama and the fake provider need none.
# docker compose passes them to the API as AI__Anthropic__ApiKey and so on. The dev container doesn't read .env
# (Claude Code runs there); for "dotnet run" in it, use user secrets:
#   dotnet user-secrets set AI:Anthropic:ApiKey <key> --project src/SupportDesk.Api
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
