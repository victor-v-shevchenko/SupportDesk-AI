# Copy this file to .env (gitignored) and fill it in. Never commit .env.
# docker compose (at the repository root) and the dev container both read .env.

# Database. The user and database names are not secret; the password is.
POSTGRES_USER=supportdesk
POSTGRES_PASSWORD=
POSTGRES_DB=supportdesk
# ConnectionStrings__SupportDesk is built from these three values in docker-compose.yml,
# so the password lives in one place.

# Model providers for docker compose: Fake, Ollama, Anthropic or OpenAI (chat); Fake, Ollama, Voyage or OpenAI (embeddings).
# Not secret. In the dev container, pass AI__Chat__Provider on the command line instead (see CLAUDE.md).
AI_CHAT_PROVIDER=Ollama
AI_EMBEDDINGS_PROVIDER=Ollama

# Model provider keys. Fill in only the ones you use; Ollama and the fake provider need none.
# docker compose passes them to the API as AI__Anthropic__ApiKey and so on. The dev container doesn't read .env
# (Claude Code runs there); for "dotnet run" in it, use user secrets:
#   dotnet user-secrets set AI:Anthropic:ApiKey <key> --project src/SupportDesk.Api
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
